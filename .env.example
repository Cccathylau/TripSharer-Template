# Notion Integration Token
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token

# Google Geocoding API Key (optional, for international trips)
# Used as primary geocoder; falls back to Nominatim if not set
GOOGLE_GEOCODING_KEY=your_google_geocoding_api_key

# Amap (高德) API Key (required for domestic China trips)
AMAP_KEY=your_amap_api_key

# Tencent COS credentials (only needed if deploying to COS)
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
